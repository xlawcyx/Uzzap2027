rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(username) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(username)).data.authUid == request.auth.uid;
    }

    function validPresence(status) {
      return status in ['ONLINE', 'AWAY', 'BUSY', 'INVISIBLE', 'OFFLINE'];
    }

    match /users/_ping {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{username} {
      allow read: if signedIn() && resource.data.authUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && validPresence(request.resource.data.status)
        && request.resource.data.keys().hasOnly([
          'authUid', 'username', 'displayName', 'phoneNumber', 'status',
          'statusMessage', 'avatarEmoji', 'phoneVerified', 'vibrationEnabled',
          'createdAt', 'lastSeen'
        ]);
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && validPresence(request.resource.data.status)
        && request.resource.data.keys().hasOnly([
          'authUid', 'username', 'displayName', 'phoneNumber', 'status',
          'statusMessage', 'avatarEmoji', 'phoneVerified', 'vibrationEnabled',
          'createdAt', 'lastSeen'
        ]);
      allow delete: if signedIn() && resource.data.authUid == request.auth.uid;

      match /inbox/{messageId} {
        allow read, delete: if ownsUser(username)
          || (signedIn() && resource.data.senderUid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.id == messageId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid ==
            get(/databases/$(database)/documents/public_profiles/$(request.resource.data.senderUsername)).data.authUid
          && request.resource.data.senderDisplayName ==
            get(/databases/$(database)/documents/public_profiles/$(request.resource.data.senderUsername)).data.displayName
          && request.resource.data.recipientUid ==
            get(/databases/$(database)/documents/users/$(username)).data.authUid
          && request.resource.data.recipientUsername == username
          && request.resource.data.type in ['TEXT', 'BUZZ']
          && request.resource.data.status == 'SENT'
          && request.resource.data.body.size() <= 4000
          && request.resource.data.keys().hasOnly([
            'id', 'conversationId', 'senderUsername', 'senderDisplayName',
            'recipientUsername', 'senderUid', 'recipientUid', 'type', 'body',
            'replyToBody', 'timestamp', 'status'
          ]);
        allow update: if false;
      }
    }

    match /public_profiles/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && validPresence(request.resource.data.status)
        && request.resource.data.keys().hasOnly([
          'authUid', 'username', 'displayName', 'status', 'statusMessage',
          'avatarEmoji', 'lastSeen'
        ]);
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && validPresence(request.resource.data.status)
        && request.resource.data.keys().hasOnly([
          'authUid', 'username', 'displayName', 'status', 'statusMessage',
          'avatarEmoji', 'lastSeen'
        ]);
      allow delete: if signedIn() && resource.data.authUid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.resource.data.id == conversationId
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participants.size() == 2
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && request.resource.data.participantUids[0] ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.participants[0])).data.authUid
        && request.resource.data.participantUids[1] ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.participants[1])).data.authUid
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastSenderUid ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.lastSender)).data.authUid
        && request.resource.data.keys().hasOnly([
          'id', 'lastMessage', 'lastTimestamp', 'lastSender', 'lastSenderUid',
          'participants', 'participantUids'
        ]);
      allow update: if signedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastTimestamp', 'lastSender', 'lastSenderUid',
          'participants', 'participantUids'
        ])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastSenderUid ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.lastSender)).data.authUid
        && request.resource.data.participants.size() == 2
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.participants[0])).data.authUid
        && request.resource.data.participantUids[1] ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.participants[1])).data.authUid
        && (
          !('participants' in resource.data)
          || request.resource.data.participants == resource.data.participants
        )
        && (
          !('participantUids' in resource.data)
          || request.resource.data.participantUids == resource.data.participantUids
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && (
            resource.data.senderUid == request.auth.uid
            || request.auth.uid in
              getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
          );
        allow create: if signedIn()
          && request.resource.data.id == messageId
          && request.resource.data.conversationId == conversationId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid ==
            get(/databases/$(database)/documents/public_profiles/$(request.resource.data.senderUsername)).data.authUid
          && request.resource.data.senderDisplayName ==
            get(/databases/$(database)/documents/public_profiles/$(request.resource.data.senderUsername)).data.displayName
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.recipientUid ==
            get(/databases/$(database)/documents/public_profiles/$(request.resource.data.recipientUsername)).data.authUid
          && request.resource.data.senderUsername in
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.recipientUsername in
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.recipientUid in
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
          && request.auth.uid in
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
          && request.resource.data.type in ['TEXT', 'BUZZ']
          && request.resource.data.status == 'SENT'
          && request.resource.data.body.size() <= 4000
          && request.resource.data.keys().hasOnly([
            'id', 'conversationId', 'senderUsername', 'senderDisplayName',
            'recipientUsername', 'senderUid', 'recipientUid', 'type', 'body',
            'replyToBody', 'timestamp', 'status'
          ]);
        allow update: if false;
        allow delete: if signedIn() && resource.data.senderUid == request.auth.uid;
      }
    }

    match /chatrooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.id == roomId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.chatterCount == 1
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.topic.size() <= 500
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'topic', 'category', 'chatterCount', 'createdByUid', 'createdAt'
        ]);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatterCount'])
        && request.resource.data.chatterCount >= 0
        && (
          (
            request.resource.data.chatterCount == resource.data.chatterCount + 1
            && !exists(/databases/$(database)/documents/chatrooms/$(roomId)/members/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/chatrooms/$(roomId)/members/$(request.auth.uid))
          )
          || (
            request.resource.data.chatterCount == resource.data.chatterCount - 1
            && exists(/databases/$(database)/documents/chatrooms/$(roomId)/members/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/chatrooms/$(roomId)/members/$(request.auth.uid))
          )
        );
      allow delete: if signedIn() && resource.data.createdByUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.id == messageId
          && request.resource.data.roomId == roomId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid ==
            get(/databases/$(database)/documents/public_profiles/$(request.resource.data.senderUsername)).data.authUid
          && exists(/databases/$(database)/documents/chatrooms/$(roomId)/members/$(request.auth.uid))
          && request.resource.data.senderRole == 'MEMBER'
          && request.resource.data.isSystem == false
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 4000
          && request.resource.data.keys().hasOnly([
            'id', 'roomId', 'senderUsername', 'senderUid', 'senderRole',
            'message', 'timestamp', 'isSystem'
          ]);
        allow update: if false;
        allow delete: if signedIn() && resource.data.senderUid == request.auth.uid;
      }

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['authUid', 'joinedAt']);
        allow update: if false;
        allow delete: if signedIn() && memberUid == request.auth.uid;
      }
    }

    match /friend_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.id == requestId
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid != request.resource.data.toUid
        && request.resource.data.fromUsername != request.resource.data.toUsername
        && request.resource.data.status == 'PENDING'
        && request.resource.data.fromUid ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.fromUsername)).data.authUid
        && request.resource.data.fromDisplayName ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.fromUsername)).data.displayName
        && request.resource.data.toUid ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.toUsername)).data.authUid
        && request.resource.data.keys().hasOnly([
          'id', 'fromUsername', 'fromDisplayName', 'toUsername', 'fromUid',
          'toUid', 'status', 'timestamp'
        ]);
      allow read, delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['ACCEPTED', 'DECLINED'];
    }

    match /ugc_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporter ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.reporter)).data.username
        && request.resource.data.target.size() > 0
        && request.resource.data.target.size() <= 200
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200
        && request.resource.data.details.size() <= 4000
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'reporter', 'target', 'reason', 'details', 'timestamp'
        ]);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
