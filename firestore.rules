rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(username) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(username)).data.authUid == request.auth.uid;
    }

    match /users/_ping {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{username} {
      allow read: if signedIn() && resource.data.authUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly([
          'authUid', 'username', 'displayName', 'phoneNumber', 'status',
          'statusMessage', 'avatarEmoji', 'phoneVerified', 'vibrationEnabled',
          'createdAt', 'lastSeen'
        ]);
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if signedIn() && resource.data.authUid == request.auth.uid;

      match /inbox/{messageId} {
        allow read, delete: if ownsUser(username);
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid ==
            get(/databases/$(database)/documents/public_profiles/$(request.resource.data.senderUsername)).data.authUid
          && request.resource.data.recipientUid ==
            get(/databases/$(database)/documents/users/$(username)).data.authUid;
        allow update: if false;
      }
    }

    match /public_profiles/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly([
          'authUid', 'username', 'displayName', 'status', 'statusMessage',
          'avatarEmoji', 'lastSeen'
        ]);
      allow update: if signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.keys().hasOnly([
          'authUid', 'username', 'displayName', 'status', 'statusMessage',
          'avatarEmoji', 'lastSeen'
        ]);
      allow delete: if signedIn() && resource.data.authUid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participants.size() == 2
        && request.resource.data.participantUids.size() == 2
        && request.resource.data.participantUids[0] ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.participants[0])).data.authUid
        && request.resource.data.participantUids[1] ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.participants[1])).data.authUid;
      allow update: if signedIn()
        && request.auth.uid in request.resource.data.participantUids
        && (
          !('participantUids' in resource.data)
          || request.resource.data.participantUids == resource.data.participantUids
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    match /chatrooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chatterCount'])
        && request.resource.data.chatterCount >= 0
        && (
          request.resource.data.chatterCount == resource.data.chatterCount + 1
          || request.resource.data.chatterCount == resource.data.chatterCount - 1
        );
      allow delete: if signedIn() && resource.data.createdByUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /friend_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.fromUsername)).data.authUid
        && request.resource.data.toUid ==
          get(/databases/$(database)/documents/public_profiles/$(request.resource.data.toUsername)).data.authUid;
      allow read, update, delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /ugc_reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
